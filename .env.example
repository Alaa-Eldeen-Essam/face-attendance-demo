# Database Configuration
DB_USER=attendance
DB_PASSWORD=attendance
DB_NAME=attendance_demo

# PgAdmin Configuration
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# FastAPI Configuration
LOG_LEVEL=INFO

# Recognition Model Configuration
SIMILARITY_THRESHOLD=0.45
ATTENDANCE_WINDOW_MINUTES=30
FACE_QUALITY_THRESHOLD=0.5
UNKNOWN_SIMILARITY_THRESHOLD=0.5

# Tracker Configuration
TRACKER_MAX_AGE=10
TRACKER_MIN_HITS=1
TRACKER_IOU_THRESHOLD=0.3

# Identity Tracking
TRACK_IDENTITY_HISTORY=5
TRACK_IDENTITY_CONFIRM_FRAMES=3
UNKNOWN_CONFIRM_FRAMES=5
IDENTITY_LOCK_MIN_SCORE=0.50

# GPU Configuration (only for GPU variant)
CUDA_VISIBLE_DEVICES=0

# Optional: Custom database URL
# DATABASE_URL=postgresql://attendance:password@db:5432/attendance_db
